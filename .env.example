# Coffee Connoisseur — environment template (migration to DigitalOcean).
# Copy to .env for local dev (gitignored). Set real values in DO App Platform for prod.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@host:3306/coffee   # DO Managed MySQL connection string

# --- Auth (Better Auth, M5) ---
BETTER_AUTH_SECRET=generate-a-long-random-secret       # required; e.g. `openssl rand -hex 32`
BETTER_AUTH_URL=http://localhost:3000                  # app's public origin (prod: your App URL)

# --- AI chat (OpenRouter, M1.1) ---
OPENROUTER_API_KEY=                                    # OpenRouter key (free tier ok); chat degrades if unset
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1       # optional override
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free       # optional override

# --- Object storage (DO Spaces, M3.1) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com    # your Spaces region endpoint
SPACES_REGION=nyc3
SPACES_BUCKET=your-space-name
SPACES_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret
SPACES_PUBLIC_BASE_URL=                                # optional CDN base; falls back to virtual-hosted URL

# Maps use Leaflet + OpenStreetMap — no key required (M2.1).

# --- Analytics (PostHog) ---
VITE_PUBLIC_POSTHOG_KEY=                                   # PostHog project key (optional); analytics disabled if unset
VITE_PUBLIC_POSTHOG_HOST=                                  # PostHog host (optional); defaults to https://us.i.posthog.com

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=                                     # Stripe secret key (sk_test_... or sk_live_...)
STRIPE_PUBLISHABLE_KEY=                                # Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_STARTER_PRICE_ID=                               # Price ID for starter plan (price_...)
